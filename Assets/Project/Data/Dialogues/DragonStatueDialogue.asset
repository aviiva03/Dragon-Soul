  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0e659ed675d26fc4e912b630596483d9, type: 3}
  m_Name: DragonStatueDialogue
  m_EditorClassIdentifier: 
  dialogueID: DragonStatueDialogue
  startNodeId: start
  nodes:
  - nodeId: start
    speakerName: "\u0411\u0438\u044E:"
    text: "\u0421\u043C\u043E\u0442\u0440\u0438 \u2014 \u0441\u0442\u0430\u0442\u0443\u044F
      \u0414\u0440\u0430\u043A\u043E\u043D\u0430. \u0423\u0437\u043D\u0430\u0451\u0448\u044C?"
    overrideCamera: {fileID: 0}
    choices:
    - choiceText: "\u0417\u0434\u0435\u0441\u044C \u0445\u0440\u0430\u043D\u0438\u043B\u0441\u044F
        \u041A\u0430\u043C\u0435\u043D\u044C \u0414\u0440\u0430\u043A\u043E\u043D\u0430...
        \u0434\u043B\u044F \u0440\u0438\u0442\u0443\u0430\u043B\u0430 \u0413\u0430\u0440\u043C\u043E\u043D\u0438\u0438.
        \u0410 \u0441\u0435\u0439\u0447\u0430\u0441 \u043F\u0443\u0441\u0442\u043E."
      nextNodeId: node1
    nextNodeId: 
  - nodeId: node1
    speakerName: "\u0411\u0438\u044E:"
    text: "\u0412\u0435\u0440\u043D\u043E. \u0422\u0432\u043E\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
      \u0440\u0430\u0441\u043A\u043E\u043B\u043E\u043B\u0441\u044F \u043D\u0430\u0434\u0432\u043E\u0435
      \u0432 \u0434\u0435\u043D\u044C \u041F\u0430\u0434\u0435\u043D\u0438\u044F
      \u2014 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0443 \u0442\u0435\u0431\u044F,
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0443 \u0421\u044F\u043E\u043B\u0443\u043D\u0430.
      \u042D\u0442\u043E\u043C\u0443 \u043C\u0435\u0441\u0442\u0443 \u043E\u043D
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442."
    overrideCamera: {fileID: 0}
    choices:
    - choiceText: "\u0410 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
        \u043A\u0430\u043C\u043D\u0438?"
      nextNodeId: node2
    nextNodeId: 
  - nodeId: node2
    speakerName: "\u0411\u0438\u044E:"
    text: "\u041D\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u043E\u0441\u0442\u0440\u043E\u0432\u0430\u0445.
      \u0420\u0443\u0431\u0438\u043D\u043E\u0432\u044B\u0439 \u0438 \u0421\u0430\u043F\u0444\u0438\u0440\u043E\u0432\u044B\u0439
      \u2014 \u0442\u0430\u043C \u0442\u043E\u0436\u0435 \u0441\u0442\u043E\u044F\u0442
      \u0441\u0442\u0430\u0442\u0443\u0438 \u0414\u0440\u0430\u043A\u043E\u043D\u043E\u0432,
      \u0438 \u043A\u0430\u043C\u043D\u0438 \u0434\u043E\u043B\u0436\u043D\u044B
      \u0431\u044B\u0442\u044C \u043F\u0440\u0438 \u043D\u0438\u0445. \u0421\u043E\u0431\u0435\u0440\u0438
      \u0432\u0441\u0435 \u2014 \u0438 \u0440\u0438\u0442\u0443\u0430\u043B \u0441\u0442\u0430\u043D\u0435\u0442
      \u0432\u043E\u0437\u043C\u043E\u0436\u0435\u043D."
    overrideCamera: {fileID: 0}
    choices:
    - choiceText: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E. \u0417\u043D\u0430\u0447\u0438\u0442,
        \u0438\u0434\u0451\u043C \u0437\u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C\u0438."
      nextNodeId: node3
    nextNodeId: 
  - nodeId: node3
    speakerName: "\u0411\u0438\u044E:"
    text: "\u0418\u043C\u0435\u043D\u043D\u043E. \u0411\u0435\u0437 \u043D\u0438\u0445
      \u043C\u0438\u0440 \u043D\u0435 \u0441\u043E\u0431\u0440\u0430\u0442\u044C."
    overrideCamera: {fileID: 0}
    choices: []
    nextNodeId: END
